{
    "name": "dominionizer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "workspaces": [
        "tools/wiki-bot"
    ],
    "scripts": {
        "prepare": "husky",
        "start": "ng serve",
        "start:prod": "ng build && http-server -p 8080 -o -c-1 ./dist",
        "build": "node ./scripts/build.ts",
        "build:changelog": "conventional-changelog -i CHANGELOG.md -s",
        "extract-i18n": "ng extract-i18n",
        "test": "ng test",
        "test:coverage": "npm run test -- --no-watch --coverage",
        "test:ci": "npm run test:coverage -- --no-progress",
        "eslint": "eslint .",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "stylelint": "stylelint \"**/*.scss\" --ignore-path .gitignore --cache",
        "markdownlint": "markdownlint \"**/*.md\" --ignore-path .gitignore"
    },
    "dependencies": {
        "@angular/animations": "22.2.6",
        "@angular/cdk": "22.2.7",
        "@angular/common": "22.2.6",
        "@angular/compiler": "22.2.6",
        "@angular/core": "22.2.6",
        "@angular/forms": "22.2.6",
        "@angular/material": "22.2.7",
        "@angular/platform-browser": "22.2.6",
        "@angular/platform-browser-dynamic": "22.2.6",
        "@angular/router": "22.2.6",
        "@angular/service-worker": "22.2.6",
        "chance": "1.1.13",
        "material-design-icons": "3.0.1",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "0.16.0"
    },
    "devDependencies": {
        "@angular-devkit/architect": "0.2202.7",
        "@angular-eslint/builder": "22.7.0",
        "@angular-eslint/eslint-plugin": "22.7.0",
        "@angular-eslint/eslint-plugin-template": "22.7.0",
        "@angular-eslint/schematics": "22.7.0",
        "@angular-eslint/template-parser": "22.7.0",
        "@angular/build": "22.2.7",
        "@angular/cli": "22.2.7",
        "@angular/compiler-cli": "22.2.6",
        "@angular/language-service": "22.2.6",
        "@angular/localize": "22.2.6",
        "@commitlint/cli": "20.3.0",
        "@commitlint/config-conventional": "20.3.0",
        "@eslint/compat": "2.0.0",
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "9.39.2",
        "@eslint/json": "0.14.0",
        "@types/chance": "1.1.7",
        "@types/node": "24.1.0",
        "@typescript-eslint/eslint-plugin": "8.72.2",
        "@typescript-eslint/parser": "8.72.2",
        "@vitest/coverage-v8": "5.1.0",
        "angular-eslint": "22.7.0",
        "commitizen": "4.3.1",
        "conventional-changelog-cli": "5.0.0",
        "cz-conventional-changelog": "3.3.0",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-unused-imports": "4.3.0",
        "globals": "17.0.0",
        "http-server": "14.1.1",
        "husky": "9.1.7",
        "jsdom": "31.0.1",
        "lint-staged": "16.2.7",
        "markdownlint-cli": "0.47.0",
        "prettier": "3.7.4",
        "stylelint": "16.26.1",
        "stylelint-config-standard-scss": "16.0.0",
        "stylelint-prettier": "5.0.3",
        "svgo": "4.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vitest": "5.1.0",
        "vitest-when": "1.0.0"
    }
}
